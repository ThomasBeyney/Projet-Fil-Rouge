# Copier vers backend/.env. Depuis Supabase > Connect > Session pooler, copier l'URI.
# Ne jamais commiter le fichier .env !
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_MONITORING=true
MONITOR_INTERVAL_SECONDS=60
